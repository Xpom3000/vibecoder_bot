[Unit]
Description=VibeCoder Assistant Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/vibecoder_bot
EnvironmentFile=/root/vibecoder_bot/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/vibecoder_bot/.venv/bin/python /root/vibecoder_bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
